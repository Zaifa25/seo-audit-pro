{
  "manifest_version": 3,
  "name": "SEO Audit Pro",
  "short_name": "SEO Audit Pro",
  "version": "1.0.0",
  "description": "A complete on-page SEO audit tool. Analyze meta tags, headings, images, links, structured data, performance, accessibility, security and more — all in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEO Audit Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "minimum_chrome_version": "110"
}
